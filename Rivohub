local function handleSubmit()
    if KEY_COOLDOWN or KEY_UNLOCKED then return end
    local trimmed=keyBox.Text:match("^%s*(.-)%s*$")
    if trimmed=="" then
        statusMsg.Text="Key field is empty."
        statusMsg.TextColor3=T.DIM
        return
    end
    if trimmed==VALID_KEY then
        statusMsg.Text=""
        unlockAndOpen()
    else
        keyAttempts=keyAttempts+1
        task.spawn(shakeCard)
        if keyAttempts>=5 then
            KEY_COOLDOWN=true
            submitBtn.Text="Cooling down..."
            for i=10,1,-1 do
                statusMsg.Text="Too many attempts. Wait "..i.."s"
                statusMsg.TextColor3=T.GOLD
                task.wait(1)
            end
            keyAttempts=0
            KEY_COOLDOWN=false
            submitBtn.Text="Verify Key"
            statusMsg.Text=""
        else
            local rem=5-keyAttempts
            statusMsg.Text="Invalid key. "..rem.." attempt"..(rem==1 and "" or "s").." left."
            statusMsg.TextColor3=T.RED
        end
    end
end

