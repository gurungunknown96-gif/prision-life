local espData={}

local function clearESP(p)
    if espData[p] then
        for _,d in pairs(espData[p]) do pcall(function() d:Remove() end) end
        espData[p]=nil
    end
end

local function getESP(p)
    if espData[p] then return espData[p] end
    local d={
        box    =Drawing.new("Square"),
        boxOut =Drawing.new("Square"),
        name   =Drawing.new("Text"),
        dist   =Drawing.new("Text"),
        hbBg   =Drawing.new("Square"),
        hbFill =Drawing.new("Square"),
    }
    d.box.Filled=false; d.box.Thickness=1.5; d.box.Visible=false
    d.boxOut.Filled=false; d.boxOut.Thickness=3; d.boxOut.Color=Color3.new(0,0,0); d.boxOut.Visible=false; d.boxOut.Transparency=0.5
    d.name.Size=13; d.name.Font=Drawing.Fonts.GothamBold; d.name.Center=true; d.name.Outline=true; d.name.Visible=false
    d.dist.Size=11; d.dist.Font=Drawing.Fonts.Gotham; d.dist.Center=true; d.dist.Outline=true; d.dist.Color=Color3.new(1,1,1); d.dist.Visible=false
    d.hbBg.Filled=true; d.hbBg.Color=Color3.new(0,0,0); d.hbBg.Visible=false; d.hbBg.Thickness=1
    d.hbFill.Filled=true; d.hbFill.Visible=false; d.hbFill.Thickness=1
    espData[p]=d; return d
end

local function teamCol(p)
    if p.Team then return BrickColor.new(p.Team.TeamColor).Color end
    return Color3.fromRGB(255,60,60)
end

local function rayOK(from,to)
    local rp=RaycastParams.new()
    rp.FilterDescendantsInstances={lp.Character or workspace}
    rp.FilterType=Enum.RaycastFilterType.Exclude
    return workspace:Raycast(from,to-from,rp)==nil
end

local flyBV,flyBG=nil,nil
local function startFly()
    local c=lp.Character; if not c then return end
    local hrp=c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    flyBV=Instance.new("BodyVelocity"); flyBV.MaxForce=Vector3.new(1e5,1e5,1e5); flyBV.Parent=hrp
    flyBG=Instance.new("BodyGyro"); flyBG.MaxTorque=Vector3.new(1e5,1e5,1e5); flyBG.P=1e4; flyBG.Parent=hrp
end
local function stopFly()
    if flyBV then flyBV:Destroy(); flyBV=nil end
    if flyBG then flyBG:Destroy(); flyBG=nil end
end

local function getBest()
    local c=lp.Character; if not c then return end
    local hrp=c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local sc=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    local best,bScore=nil,math.huge
    for _,p in pairs(Players:GetPlayers()) do
        if p==lp then continue end
        if St.AimTeam=="Enemies" and p.Team==lp.Team then continue end
        local pc=p.Character; if not pc then continue end
        local h=pc:FindFirstChildOfClass("Humanoid"); if not h or h.Health<=0 then continue end
        local ap=pc:FindFirstChild(St.AimPart) or pc:FindFirstChild("HumanoidRootPart"); if not ap then continue end
        local sp,dep,on=Camera:WorldToScreenPoint(ap.Position)
        if not on or dep<0 then continue end
        local sp2=Vector2.new(sp.X,sp.Y)
        if (sp2-sc).Magnitude>St.FOVSize then continue end
        if St.WallCheck and not rayOK(hrp.Position,ap.Position) then continue end
        local score=St.ClosestTarget and (hrp.Position-ap.Position).Magnitude or (sp2-sc).Magnitude
        if score<bScore then bScore=score; best=ap end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    hue=(hue+0.4)%360
    local ac=Color3.fromHSV(hue/360,0.7,1)
    local ac2=Color3.fromHSV(((hue+60)%360)/360,0.7,1)
    accentGrad.Color=ColorSequence.new{ColorSequenceKeypoint.new(0,ac),ColorSequenceKeypoint.new(1,ac2)}
    brandDot.BackgroundColor3=ac
    hdrLine.BackgroundColor3=ac
    hdrLbl.TextColor3=ac
    fovDraw.Color=ac

    local sc=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    fovDraw.Position=sc; fovDraw.Radius=St.FOVSize
    fovDraw.Visible=St.ShowFOV and St.AimbotOn

    if St.AimbotOn then
        local t=getBest()
        if t then
            local dir=(t.Position-Camera.CFrame.Position).Unit
            Camera.CFrame=CFrame.lookAt(Camera.CFrame.Position,Camera.CFrame.Position+dir)
        end
    end

    local c=lp.Character
    local hrp=c and c:FindFirstChild("HumanoidRootPart")
    local hum=c and c:FindFirstChildOfClass("Humanoid")

    if St.Fly and hrp then
        if not flyBV then startFly() end
        if flyBV and flyBG then
            local mv=Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then mv=mv+Camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then mv=mv-Camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then mv=mv-Camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then mv=mv+Camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then mv=mv+Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then mv=mv-Vector3.new(0,1,0) end
            flyBV.Velocity=mv.Magnitude>0 and mv.Unit*St.WalkSpeed*1.6 or Vector3.zero
            flyBG.CFrame=Camera.CFrame
        end
    else stopFly() end

    if hum then
        hum.WalkSpeed=St.WalkSpeed; hum.JumpPower=St.JumpPower
        if St.AntiTaze and hum.WalkSpeed<6 then hum.WalkSpeed=St.WalkSpeed end
    end

    if St.Noclip and c then
        for _,v in pairs(c:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide=false end
        end
    end

    local anyESP=St.BoxESP or St.OutlineESP or St.NameESP or St.DistESP or St.HealthBar

    for _,p in pairs(Players:GetPlayers()) do
        if p==lp then clearESP(p); continue end
        local skip=not St.TeamESP and p.Team==lp.Team
        local pc=p.Character
        local ph=pc and pc:FindFirstChildOfClass("Humanoid")
        if not anyESP or skip or not pc or not ph or ph.Health<=0 then
            clearESP(p); continue
        end
        local d=getESP(p)
        local col=St.TeamColors and teamCol(p) or Color3.fromRGB(255,60,60)
        local root=pc:FindFirstChild("HumanoidRootPart")
        local head=pc:FindFirstChild("Head")
        if not root or not head then clearESP(p); continue end

        local topW=head.Position+Vector3.new(0,1.2,0)
        local botW=root.Position-Vector3.new(0,3,0)
        local ts,td,ton=Camera:WorldToScreenPoint(topW)
        local bs=Camera:WorldToScreenPoint(botW)

        if not ton or td<0 then
            for _,obj in pairs(d) do obj.Visible=false end
            continue
        end

        local topS=Vector2.new(ts.X,ts.Y)
        local botS=Vector2.new(bs.X,bs.Y)
        local boxH=math.abs(botS.Y-topS.Y)
        local boxW=boxH*0.45

        if St.OutlineESP then
            d.boxOut.Visible=true; d.boxOut.Size=Vector2.new(boxW+4,boxH+4)
            d.boxOut.Position=Vector2.new(topS.X-boxW/2-2,topS.Y-2)
        else d.boxOut.Visible=false end

        if St.BoxESP then
            d.box.Visible=true; d.box.Color=col
            d.box.Size=Vector2.new(boxW,boxH)
            d.box.Position=Vector2.new(topS.X-boxW/2,topS.Y)
        else d.box.Visible=false end

        if St.NameESP then
            d.name.Visible=true; d.name.Color=col
            d.name.Text=p.Name
            d.name.Position=Vector2.new(topS.X,topS.Y-15)
        else d.name.Visible=false end

        if St.DistESP then
            local dist=hrp and math.floor((hrp.Position-root.Position).Magnitude) or 0
            d.dist.Visible=true; d.dist.Text=dist.."m"
            d.dist.Position=Vector2.new(topS.X,botS.Y+3)
        else d.dist.Visible=false end

        if St.HealthBar then
            local hpPct=ph.Health/ph.MaxHealth
            local barH=boxH*hpPct
            local barX=topS.X+boxW/2+3
            d.hbBg.Visible=true; d.hbBg.Size=Vector2.new(4,boxH); d.hbBg.Position=Vector2.new(barX,topS.Y)
            d.hbFill.Visible=true
            d.hbFill.Color=Color3.fromRGB(math.floor(255*(1-hpPct)),math.floor(255*hpPct),40)
            d.hbFill.Size=Vector2.new(4,barH); d.hbFill.Position=Vector2.new(barX,botS.Y-barH)
        else d.hbBg.Visible=false; d.hbFill.Visible=false end
    end

    for p in pairs(espData) do
        if not p.Parent then clearESP(p) end
    end
end)

