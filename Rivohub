local function N(cls,props,par)
    local o=Instance.new(cls)
    for k,v in pairs(props or {}) do o[k]=v end
    if par then o.Parent=par end
    return o
end
local function Crn(r,p) return N("UICorner",{CornerRadius=UDim.new(0,r or 6)},p) end
local function Str(c,t,p) return N("UIStroke",{Color=c or T.STROKE,Thickness=t or 1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},p) end
local function Grad(c1,c2,rot,p)
    local g=N("UIGradient",{Rotation=rot or 90},p)
    g.Color=ColorSequence.new{ColorSequenceKeypoint.new(0,c1),ColorSequenceKeypoint.new(1,c2)}
    return g
end
local function Lbl(par,txt,sz,pos,col,ts,fnt,xa)
