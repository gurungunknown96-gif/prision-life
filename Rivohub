local function Tog(pg,txt,def,cb)
    local row=N("TextButton",{
        Size=UDim2.new(1,0,0,32),BackgroundColor3=T.CARD,
        Text="",AutoButtonColor=false,
    },pg)
    Crn(7,row); Str(T.STROKE,1,row)
    Lbl(row,txt,UDim2.new(1,-52,1,0),UDim2.fromOffset(10,0),T.TEXT,12)
    local trk=N("Frame",{
        Size=UDim2.fromOffset(36,18),Position=UDim2.new(1,-46,0.5,-9),
        BackgroundColor3=T.STROKE,BorderSizePixel=0,
    },row)
    Crn(9,trk)
    local knob=N("Frame",{
        Size=UDim2.fromOffset(14,14),Position=UDim2.fromOffset(2,2),
        BackgroundColor3=T.TEXT,BorderSizePixel=0,
    },trk)
    Crn(7,knob)
    local state=def or false
    local function ap(instant)
        local inf=TweenInfo.new(instant and 0 or 0.15)
        TweenService:Create(knob,inf,{Position=UDim2.fromOffset(state and 20 or 2,2)}):Play()
        TweenService:Create(trk,inf,{BackgroundColor3=state and T.ACCENT or T.STROKE}):Play()
        TweenService:Create(row,inf,{BackgroundColor3=state and Color3.fromRGB(26,22,40) or T.CARD}):Play()
    end
    ap(true)
    row.MouseButton1Click:Connect(function()
        state=not state; ap(false)
        if cb then cb(state) end
    end)
    return row,function() return state end
end

