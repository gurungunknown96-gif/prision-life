local function Sld(pg,txt,mn,mx,def,cb)
    local h=N("Frame",{Size=UDim2.new(1,0,0,48),BackgroundColor3=T.CARD},pg)
    Crn(7,h); Str(T.STROKE,1,h)
    local vl=Lbl(h,txt..":  "..def,UDim2.new(1,-20,0,22),UDim2.fromOffset(10,4),T.TEXT,12)
    local bg=N("Frame",{
        Size=UDim2.new(1,-20,0,5),Position=UDim2.new(0,10,1,-13),
        BackgroundColor3=T.STROKE,BorderSizePixel=0,
    },h)
    Crn(3,bg)
    local fl=N("Frame",{Size=UDim2.new(0,0,1,0),BackgroundColor3=T.ACCENT,BorderSizePixel=0},bg)
    Crn(3,fl)
    local val=def
    local function sv(v,fire)
        val=math.clamp(math.floor(v),mn,mx)
        fl.Size=UDim2.new((val-mn)/(mx-mn),0,1,0)
        vl.Text=txt..":  "..tostring(val)
        if fire and cb then cb(val) end
    end
    sv(def,false)
    local dr=false
    bg.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dr=true end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dr=false end
    end)
    RunService.RenderStepped:Connect(function()
        if not dr or not h.Parent then return end
        local m=UIS:GetMouseLocation()
        local a=bg.AbsolutePosition; local s=bg.AbsoluteSize
        sv(mn+(mx-mn)*math.clamp((m.X-a.X)/s.X,0,1),true)
    end)
    return h
end

